# ========== 天枢后端环境变量（复制为 .env 后填写真实值；.env 不提交 Git）==========

# 运行环境: development / production
FLASK_ENV=development

# MySQL 连接（W1 第一天需要：把下面的账号密码改成你本机的）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你的MySQL密码
DB_NAME=tianshu_utms

# JWT 签名密钥（开发期固定，上线换随机长串）
JWT_SECRET_KEY=tianshu-dev-jwt-secret-change-me

# Redis（W4 用，W1 可先不启动）
REDIS_URL=redis://127.0.0.1:6379/0

# 敏感字段 AES 密钥（必须 16/24/32 位；D-23 手机号加密，后端模块上线时启用）
AES_SECRET_KEY=tianshu-aes-16ch

# HMAC 摘要密钥（与 DDL 种子 phone_digest 保持一致，不要改）
PHONE_HMAC_KEY=tianshu-dev-seed

# 高德 Web 服务 Key（后端逆地理用，完整值见 密钥登记-勿提交Git.txt）
AMAP_WEB_KEY=

# 仿真器默认倍速（1=真实 1秒1帧；60=答辩快进）
SIM_DEFAULT_SPEED=1
